<!-- views/profile.ejs -->

<!DOCTYPE html>
<html>
<head>
<title>Profile</title>

<style>

body{
background:#0f0f0f;
color:white;
font-family:Arial;
padding:30px;
}

.box{
background:#1b1b1b;
padding:20px;
border-radius:20px;
margin-bottom:20px;
}

img{
width:100px;
height:100px;
border-radius:50%;
}

a{
color:#4da6ff;
}

</style>
</head>

<body>

<div class="box">

<img src="https://i.imgur.com/6VBx3io.png">

<h1>
<%= user.username %>
</h1>

<a href="/forum">
Back Forum
</a>

|

<a href="/logout">
Logout
</a>

</div>

<div class="box">

<h2>Your Posts</h2>

<% posts.forEach(post=> { %>

<div>

<h3>
<%= post.title %>
</h3>

<p>
<%= post.content %>
</p>

<hr>

</div>

<% }) %>

</div>

</body>
</html>
